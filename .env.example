# ====================================================================
# Ultimate Advanced YouTube Automation AI Agent Configuration Template
# Rename this file to `.env` and fill in your API keys before running.
# ====================================================================

# 1. Google Gemini API Config (Creative Planner & Storyboarder)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI API Config (Fallback Scripts, DALL-E 3 Images, TTS Backups)
# Obtain from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# 3. ElevenLabs API Config (Premium AI Voice Narration)
# Obtain from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional Voice Presets (Default is "Adam" voice ID: pNInz6obpgqjVWt2A4mH)
ELEVENLABS_VOICE_ID=pNInz6obpgqjVWt2A4mH

# 4. Pexels API Config (Royalty-free Stock Video Retrieval)
# Obtain from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# 5. YouTube & Project Output Folders (Optional customization)
# Videos will be stored in this directory
OUTPUT_DIR=output
# Temporary cached assets directory
TEMP_DIR=temp
